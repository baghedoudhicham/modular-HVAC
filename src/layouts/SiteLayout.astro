---
import '../styles/global.css';
import { brand } from '../lib/content.js';
import { ribbon, header, footer } from '../lib/visuals.js';
interface Props {
  title: string;
  description: string;
  activePath?: string;
}
const {title, description, activePath = '/'} = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#f7f6f0" />
  <meta name="description" content={description} />
  {brand.demo && <meta name="robots" content="noindex,nofollow" />}
  <title>{title} | Roomtone — Home climate care</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <div id="top"></div>
  <Fragment set:html={ribbon()} />
  <Fragment set:html={header(activePath)} />
  <main id="main"><slot /></main>
  <Fragment set:html={footer()} />
  <script>import '../scripts/interactions.js';</script>
</body>
</html>
